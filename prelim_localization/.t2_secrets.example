# T2 cross-backbone secrets — COPY to ".t2_secrets" (gitignored) and fill in your real key.
# Do NOT paste your key into the chat; just create .t2_secrets yourself and tell me it's ready.
# I source this file and reference $T2_API_KEY — the value is never echoed or committed.

# --- Single OpenAI-compatible gateway hosting all 5 models behind ONE key (simplest) ---
# e.g. OpenRouter (https://openrouter.ai/api/v1), SiliconFlow, DeepInfra, Together, Fireworks
export T2_BASE_URL="https://openrouter.ai/api/v1"
export T2_API_KEY="sk-REPLACE_ME"

# The 5 model IDs as the provider names them (one per line, exact slugs):
export T2_MODELS="
qwen/qwen-2.5-coder-32b-instruct
deepseek/deepseek-chat
meta-llama/llama-3.3-70b-instruct
mistralai/mistral-large
z-ai/glm-4.5
"

