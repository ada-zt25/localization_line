# Preliminary-experiment local cache (fetched repo files + dataset rows; bulky, not secrets)
prelim_localization/cache/
# Extracted GitHub repo tarballs (~6 GB, regenerable by repo_snapshot.py) — NEVER commit
prelim_localization/snapshots/
# Failing-test execution-coverage cache (~50 MB, expensive: ~250 Docker runs).
# Ignored by default so a regenerated 200MB+ blob isn't auto-staged; but force-added
# ONCE (`git add -f`) as a cross-device transfer artifact — behav-132 needs it to run without Docker.
prelim_localization/egl_cov_cache.json
# Compiled pycache anywhere under prelim_localization
prelim_localization/__pycache__/

# Stale staging artifacts (duplicate of old code; not part of the project)
_upload_stage/
prelim_upload.zip

